# Copy to .env and adjust locally. Never commit .env.
NODE_ENV=development
PORT=4000

# MongoDB connection string. Atlas URI in deployed environments.
MONGODB_URI=mongodb://127.0.0.1:27017/sms_dev

# Comma-separated list of allowed browser origins.
CORS_ORIGIN=http://localhost:5173

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
